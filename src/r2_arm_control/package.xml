<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_arm_control</name>
  <version>0.1.0</version>
  <description>Single-package 2R arm control stack for R2, including Damiao hardware, ros2_control, IK, launch, and service interfaces.</description>
  <maintainer email="orangepi@example.com">orangepi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <build_depend>rosidl_default_generators</build_depend>

  <depend>ament_index_python</depend>
  <depend>controller_interface</depend>
  <depend>controller_manager</depend>
  <depend>control_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>joint_trajectory_controller</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>libserial-dev</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>pluginlib</depend>
  <depend>python3-yaml</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rclpy</depend>
  <depend>robot_state_publisher</depend>
  <depend>realtime_tools</depend>
  <depend>rcl_interfaces</depend>
  <depend>rviz2</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>xacro</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/dm_hw_plugins.xml"/>
  </export>
</package>
